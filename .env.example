BROADCASTER_USERNAME=username
# Path to a file holding the broadcaster's posting WIF (and nothing else).
# Production mounts it as a swarm secret at the default path,
# /run/secrets/broadcaster_posting_wif; set this for a local run.
BROADCASTER_POSTING_WIF_FILE=/path/to/broadcaster_posting_wif
BROADCAST_NETWORK=mainnet
API_PORT=3000
